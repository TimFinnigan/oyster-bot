# ============================================
# PLATFORM TOKENS
# ============================================
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# ============================================
# ACCESS CONTROL
# ============================================
# Telegram user IDs (comma-separated). Find yours via @userinfobot
# ALLOWED_USER_IDS=123456789

# ============================================
# API KEYS
# ============================================
# Only needed if using API key instead of Pro/Max subscription
# ANTHROPIC_API_KEY=sk-ant-api03-...

# ============================================
# CLAUDE CLI SETTINGS
# ============================================
# CLAUDE_PATH=claude
# CLAUDE_TIMEOUT_MS=120000
# CLAUDE_MAX_BUDGET_USD=1
# CLAUDE_ALLOWED_TOOLS=Read,Glob,Grep,WebSearch,WebFetch
# CLAUDE_EXTRA_PATH=/usr/local/bin:/opt/homebrew/bin
# CLAUDE_DANGEROUSLY_SKIP_PERMISSIONS=false
# CLAUDE_VERBOSE_LOGGING=false
# Grant access to additional directories (beyond working dir)
# CLAUDE_ALLOWED_DIRECTORIES=/path/to/dir1,/path/to/dir2

# ============================================
# PLUGINS
# ============================================
# Your Telegram user ID for receiving scheduled messages
# PLUGIN_TARGET_CHAT_ID=123456789

# Quotes plugin: cron schedule (default: hourly)
# QUOTES_CRON=0 9 * * *

# Weather plugin
# WEATHER_DEFAULT_LOCATION=Seattle, WA
# WEATHER_CRON=0 8 * * *
